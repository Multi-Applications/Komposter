<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <include
        android:id="@+id/setup_screen"
        layout="@layout/screen_setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/players_screen"
        layout="@layout/screen_players"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/categories_screen"
        layout="@layout/screen_categories"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/card_screen"
        layout="@layout/screen_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/discussion_screen"
        layout="@layout/screen_discussion"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/vote_screen"
        layout="@layout/screen_vote"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/reveal_screen"
        layout="@layout/screen_reveal"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
